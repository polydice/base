ARG BASE_TAG=latest
FROM polydice/base:${BASE_TAG}

# Development/testing-only packages on top of the production base image.
# build-essential and libpq-dev are already in the base image, so they are
# intentionally omitted here.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    libxml2-dev \
    libxslt1-dev \
    libsasl2-dev \
    libmcrypt-dev \
  && rm -rf /var/lib/apt/lists/*
